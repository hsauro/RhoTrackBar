<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{50B6B04B-1338-4FD9-A8B3-DD5F2412C353}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="RhoFMXTrackbarPackage.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Demo\TrackBarDemoProject.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Demo\TrackbarStylesDemoProject.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RhoFMXTrackbarPackage">
        <MSBuild Projects="RhoFMXTrackbarPackage.dproj"/>
    </Target>
    <Target Name="RhoFMXTrackbarPackage:Clean">
        <MSBuild Projects="RhoFMXTrackbarPackage.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RhoFMXTrackbarPackage:Make">
        <MSBuild Projects="RhoFMXTrackbarPackage.dproj" Targets="Make"/>
    </Target>
    <Target Name="TrackBarDemoProject">
        <MSBuild Projects="..\Demo\TrackBarDemoProject.dproj"/>
    </Target>
    <Target Name="TrackBarDemoProject:Clean">
        <MSBuild Projects="..\Demo\TrackBarDemoProject.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TrackBarDemoProject:Make">
        <MSBuild Projects="..\Demo\TrackBarDemoProject.dproj" Targets="Make"/>
    </Target>
    <Target Name="TrackbarStylesDemoProject">
        <MSBuild Projects="..\Demo\TrackbarStylesDemoProject.dproj"/>
    </Target>
    <Target Name="TrackbarStylesDemoProject:Clean">
        <MSBuild Projects="..\Demo\TrackbarStylesDemoProject.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TrackbarStylesDemoProject:Make">
        <MSBuild Projects="..\Demo\TrackbarStylesDemoProject.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="RhoFMXTrackbarPackage;TrackBarDemoProject;TrackbarStylesDemoProject"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="RhoFMXTrackbarPackage:Clean;TrackBarDemoProject:Clean;TrackbarStylesDemoProject:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="RhoFMXTrackbarPackage:Make;TrackBarDemoProject:Make;TrackbarStylesDemoProject:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
